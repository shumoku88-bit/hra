with "../hra.gpr";

project HRA_Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("test_runner.adb",
      "test_actual_admission.adb",
      "test_plan_completion_admission.adb",
      "test_envelope_entitlement_standalone.adb",
      "test_report_plan.adb",
      "test_report_account_order.adb",
      "test_household_report_observation.adb",
      "test_recent_journal.adb",
      "test_planned_payments.adb",
      "test_envelope_commitment.adb",
      "test_fulfillment_routing.adb",
      "test_envelope_fulfillment.adb",
      "test_journal_loader.adb",
      "test_account_admission.adb",
      "test_dates.adb",
      "test_clean_household_contract.adb",
      "test_proof_money_bridge.adb",
      "test_envelope_position.adb",
      "test_envelope_explanation.adb",
      "test_envelope_change.adb",
      "test_envelope_change_baseline.adb",
      "test_household_temporal.adb",
      "test_household_source_admission.adb",
      "test_envelope_cycle_comparison.adb",
      "test_household_temporal_cycle_context.adb",
      "test_account_reconciliation.adb",
      "test_household_check_observation.adb",
      "test_issues_admission.adb",
       "test_issue_observation.adb",
       "test_household_home_observation.adb",
       "test_household_home_presentation.adb",
       "test_household_home_command.adb",
       "test_household_home_interaction.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatW8", "-g", "-O2");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-E");
   end Binder;

   package Builder is
      for Executable ("test_runner.adb") use "test_runner";
      for Executable ("test_actual_admission.adb") use "test_actual_admission";
      for Executable ("test_plan_completion_admission.adb") use "test_plan_completion_admission";
      for Executable ("test_envelope_entitlement_standalone.adb") use "test_entitlement";
      for Executable ("test_report_plan.adb") use "test_report_plan";
      for Executable ("test_report_account_order.adb") use "test_report_account_order";
      for Executable ("test_household_report_observation.adb") use "test_household_report_observation";
      for Executable ("test_recent_journal.adb") use "test_recent_journal";
      for Executable ("test_planned_payments.adb") use "test_planned_payments";
      for Executable ("test_envelope_commitment.adb") use "test_envelope_commitment";
      for Executable ("test_fulfillment_routing.adb") use "test_fulfillment_routing";
      for Executable ("test_envelope_fulfillment.adb") use "test_envelope_fulfillment";
      for Executable ("test_journal_loader.adb") use "test_journal_loader";
      for Executable ("test_account_admission.adb") use "test_account_admission";
      for Executable ("test_dates.adb") use "test_dates";
      for Executable ("test_clean_household_contract.adb") use "test_clean_household_contract";
      for Executable ("test_proof_money_bridge.adb") use "test_proof_money_bridge";
      for Executable ("test_envelope_position.adb") use "test_envelope_position";
      for Executable ("test_envelope_explanation.adb") use "test_envelope_explanation";
      for Executable ("test_envelope_change.adb") use "test_envelope_change";
      for Executable ("test_envelope_change_baseline.adb") use "test_envelope_change_baseline";
      for Executable ("test_household_temporal.adb") use "test_household_temporal";
      for Executable ("test_household_source_admission.adb") use "test_household_source_admission";
      for Executable ("test_envelope_cycle_comparison.adb") use "test_envelope_cycle_comparison";
      for Executable ("test_household_temporal_cycle_context.adb") use "test_household_temporal_cycle_context";
      for Executable ("test_account_reconciliation.adb") use "test_account_reconciliation";
      for Executable ("test_household_check_observation.adb") use "test_household_check_observation";
      for Executable ("test_issues_admission.adb") use "test_issues_admission";
      for Executable ("test_issue_observation.adb") use "test_issue_observation";
      for Executable ("test_household_home_observation.adb") use "test_household_home_observation";
      for Executable ("test_household_home_presentation.adb") use "test_household_home_presentation";
      for Executable ("test_household_home_command.adb") use "test_household_home_command";
      for Executable ("test_household_home_interaction.adb") use "test_household_home_interaction";
   end Builder;
end HRA_Tests;
