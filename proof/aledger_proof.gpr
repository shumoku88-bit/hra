project ALedger_Proof is
   for Languages use ("Ada");
   for Source_Dirs use ("../src");
   for Source_Files use
     ("aledger.ads",
      "aledger-proof_core.ads",
      "aledger-proof_core.adb");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatW8", "-gnatwa");
   end Compiler;
end ALedger_Proof;
