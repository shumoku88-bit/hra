#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_root"

# Keep HRA's repository-local Alire index registration out of the user's
# ordinary Alire settings. The generated settings live under the already
# ignored repository alire/ area and are inherited by tools/prove.
alire_settings_dir="$project_root/alire/settings"
mkdir -p "$alire_settings_dir"
export ALIRE_SETTINGS_DIR="$alire_settings_dir"

test_project="$project_root/tests/hra_tests.gpr"

usage() {
  cat <<'EOF'
Usage: tools/hra COMMAND [ARGS...]

Repository commands:
  build                 Build production source with Alire
  test [FILTER ...]     Build and run all tests, or only matching focused tests
  test-list [FILTER]    List declared focused test mains
  prove                 Run the SPARK proof project
  qualify               Build production, run all tests, and prove
  clean                 Clean production, test, and proof build products

Focused test examples:
  tools/hra test money
  tools/hra test issue
  tools/hra test plan tui

An exact short test name (for example "money") selects only test_money.adb.
Otherwise each FILTER selects declared test mains whose name contains FILTER.
No FILTER keeps the full repository test behavior used by qualify and CI.

Application commands:
  home [--base ROOT] [--through DATE] [--day DATE]
                        Render the Household Home overview
  tui [--base ROOT] [--through DATE] [--day DATE]
                        Open the interactive Household Home terminal view
  check [--base ROOT]   Validate an admitted canonical Household
  report [book] [--base ROOT] [--through DATE]
                        Render the current report book
  report envelope-change [--base ROOT] [--through DATE]
         [--from cycle-start|previous-day|DATE]
                        Render same-cycle Envelope Change
  report envelope-previous-cycle [--base ROOT] [--through DATE]
                        Render aligned previous-cycle Envelope comparison
  version               Show the hra version
  app-help              Show the hra application help

This script is the repository command hub. It owns command dispatch only;
domain semantics and writer authority remain in Ada packages.
EOF
}

need_alr() {
  if ! command -v alr >/dev/null 2>&1; then
    echo "tools/hra: alr is not available on PATH" >&2
    exit 127
  fi
}

ensure_local_index() {
  need_alr
  local overlay_path="$project_root/support/alire-index"
  local index_listing
  local toolchain_listing

  # Do not pipe `alr ...` into `grep -q` here. With `set -o pipefail`, grep can
  # exit as soon as it finds a match and leave alr with SIGPIPE, turning a real
  # match into a false failure. Capture the small listing first so repeated
  # invocations remain idempotent in the repository-local persistent settings.
  if ! index_listing="$(alr index 2>/dev/null)"; then
    index_listing=""
  fi

  # ALIRE_SETTINGS_DIR starts pristine, so establish Alire's own community
  # index before placing the HRA overlay ahead of it. Do not copy or hard-code
  # the community branch here; let the installed Alire version select it.
  if [[ "$index_listing" != *community* ]]; then
    alr index --reset-community >&2
    index_listing="$(alr index 2>/dev/null)"
  fi

  if [[ -d "$overlay_path" && "$index_listing" != *hra_overlay* ]]; then
    alr index --add "$overlay_path" --name hra_overlay --before community >&2
  fi

  # Toolchain preference is also stored under ALIRE_SETTINGS_DIR. Select the
  # standard native components explicitly in this isolated settings space so
  # Alire can reuse already available matching toolchains without invoking its
  # first-run interactive assistant. Do not pin concrete versions here.
  if ! toolchain_listing="$(alr toolchain 2>/dev/null)"; then
    toolchain_listing=""
  fi
  if [[ "$toolchain_listing" != *Default* ]]; then
    alr toolchain --select gnat_native gprbuild >&2
  fi
}

list_test_mains() {
  sed -n '/for Main use/,/);/p' "$test_project" |
    sed -n 's/.*"\(test_[^"]*\.adb\)".*/\1/p'
}

short_test_name() {
  local main="$1"
  main="${main#test_}"
  printf '%s\n' "${main%.adb}"
}

append_unique_main() {
  local candidate="$1"
  local existing
  for existing in "${selected_test_mains[@]:-}"; do
    if [[ "$existing" == "$candidate" ]]; then
      return
    fi
  done
  selected_test_mains+=("$candidate")
}

select_test_mains() {
  selected_test_mains=()

  local selector
  local normalized
  local exact
  local main
  local matched
  local all_mains

  all_mains="$(list_test_mains)"

  for selector in "$@"; do
    normalized="${selector%.adb}"
    normalized="${normalized#test_}"
    if [[ -z "$normalized" ]]; then
      echo "tools/hra test: empty focused test selector" >&2
      exit 2
    fi

    exact="test_${normalized}.adb"
    matched=0

    for main in $all_mains; do
      if [[ "$main" == "$exact" ]]; then
        append_unique_main "$main"
        matched=1
        break
      fi
    done

    if [[ "$matched" -eq 1 ]]; then
      continue
    fi

    for main in $all_mains; do
      if [[ "${main%.adb}" == *"$normalized"* ]]; then
        append_unique_main "$main"
        matched=1
      fi
    done

    if [[ "$matched" -eq 0 ]]; then
      echo "tools/hra test: no declared focused test matches '$selector'" >&2
      echo "tools/hra test: use 'tools/hra test-list' to inspect names" >&2
      exit 2
    fi
  done
}

executable_for_main() {
  local main="$1"
  local executable

  executable="$(
    sed -n \
      "s/.*for Executable (\"${main}\") use \"\\([^\"]*\\)\";.*/\\1/p" \
      "$test_project"
  )"

  if [[ -n "$executable" ]]; then
    printf '%s\n' "$executable"
  else
    printf '%s\n' "${main%.adb}"
  fi
}

build_production() {
  ensure_local_index
  # Keep application stdout reserved for application output (not build logs).
  alr build >&2
}

build_tests() {
  ensure_local_index
  # Remove only old executables so a retired test cannot survive as a stale
  # runnable binary. Keep objects for incremental compilation.
  rm -rf "$project_root/tests/bin"
  # Let GPRbuild use the platform's available processor cores across the
  # independent test compilation, binding, and linking jobs.
  alr exec -- gprbuild -j0 -P "$test_project"
}

build_focused_tests() {
  ensure_local_index
  alr exec -- gprbuild -j0 -P "$test_project" "$@"
}

run_tests() {
  local found=0
  local test_exe
  for test_exe in "$project_root"/tests/bin/test_*; do
    [[ -x "$test_exe" ]] || continue
    found=1
    "$test_exe"
  done

  if [[ "$found" -eq 0 ]]; then
    echo "tools/hra: no built focused test executables found" >&2
    exit 1
  fi
}

run_focused_tests() {
  local main
  local executable
  local test_exe

  for main in "$@"; do
    executable="$(executable_for_main "$main")"
    test_exe="$project_root/tests/bin/$executable"
    if [[ ! -x "$test_exe" ]]; then
      echo "tools/hra test: expected executable not built: $test_exe" >&2
      exit 1
    fi
    "$test_exe"
  done
}

command="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command" in
  help|-h|--help)
    usage
    ;;
  build)
    ensure_local_index
    exec alr build "$@"
    ;;
  test)
    if [[ $# -eq 0 ]]; then
      build_tests
      run_tests
    else
      select_test_mains "$@"
      build_focused_tests "${selected_test_mains[@]}"
      run_focused_tests "${selected_test_mains[@]}"
    fi
    ;;
  test-list)
    if [[ $# -gt 1 ]]; then
      echo "tools/hra test-list: expected zero or one FILTER" >&2
      exit 2
    fi
    if [[ $# -eq 0 ]]; then
      while IFS= read -r main; do
        short_test_name "$main"
      done < <(list_test_mains)
    else
      filter="${1#test_}"
      filter="${filter%.adb}"
      while IFS= read -r main; do
        if [[ "${main%.adb}" == *"$filter"* ]]; then
          short_test_name "$main"
        fi
      done < <(list_test_mains)
    fi
    ;;
  prove)
    if [[ $# -ne 0 ]]; then
      echo "tools/hra prove: unexpected arguments" >&2
      exit 2
    fi
    exec "$project_root/tools/prove"
    ;;
  qualify)
    if [[ $# -ne 0 ]]; then
      echo "tools/hra qualify: unexpected arguments" >&2
      exit 2
    fi
    build_production
    build_tests
    run_tests
    "$project_root/tools/prove"
    ;;
  clean)
    need_alr
    alr clean "$@"
    rm -rf \
      "$project_root/obj" \
      "$project_root/bin" \
      "$project_root/config" \
      "$project_root/tests/obj" \
      "$project_root/tests/bin" \
      "$project_root/proof/obj"
    ;;
  home|tui|check|report|version)
    build_production
    exec "$project_root/bin/hra" "$command" "$@"
    ;;
  app-help)
    build_production
    exec "$project_root/bin/hra" help "$@"
    ;;
  *)
    echo "tools/hra: unknown command: $command" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
