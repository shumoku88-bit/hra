#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_root"

usage() {
  cat <<'EOF'
Usage: tools/hra COMMAND [ARGS...]

Repository commands:
  build                 Build production source with Alire
  test                  Build and run the repository test suites
  prove                 Run the SPARK proof project
  qualify               Build production, run tests, and prove
  clean                 Clean production, test, and proof build products

Application commands:
  home [--base ROOT] [--through DATE] [--day DATE]
                        Render the Household Home overview
  tui [--base ROOT] [--through DATE] [--day DATE]
                        Open the interactive Household Home terminal view
  check [--base ROOT]   Validate an admitted canonical Household
  report [--base ROOT]  Render the current report portfolio
  version               Show the hra version
  app-help              Show the hra application help

This script is the repository command hub. It owns command dispatch only;
domain semantics and writer authority remain in Ada packages.
EOF
}

need_alr() {
  if ! command -v alr >/dev/null 2>&1; then
    echo "tools/hra: alr is not available on PATH" >&2
    exit 127
  fi
}

ensure_local_index() {
  need_alr
  local overlay_path="$project_root/support/alire-index"
  if [[ -d "$overlay_path" ]] && ! alr index 2>/dev/null | grep -q "hra_overlay"; then
    alr index --add "$overlay_path" --name hra_overlay --before community >&2 || true
  fi
}

build_production() {
  ensure_local_index
  # Keep application stdout reserved for application output (not build logs).
  alr build >&2
}

build_tests() {
  ensure_local_index
  alr exec -- gprbuild -P "$project_root/tests/hra_tests.gpr"
}

run_tests() {
  "$project_root/tests/bin/test_runner" "$@"
  "$project_root/tests/bin/test_actual_admission"
  "$project_root/tests/bin/test_plan_completion_admission"
  "$project_root/tests/bin/test_report_account_order"
  "$project_root/tests/bin/test_household_report_observation"
  "$project_root/tests/bin/test_envelope_commitment"
  "$project_root/tests/bin/test_envelope_explanation"
  "$project_root/tests/bin/test_envelope_change"
  "$project_root/tests/bin/test_envelope_change_baseline"
  "$project_root/tests/bin/test_household_temporal"
  "$project_root/tests/bin/test_household_source_admission"
  "$project_root/tests/bin/test_envelope_cycle_comparison"
  "$project_root/tests/bin/test_household_temporal_cycle_context"
  "$project_root/tests/bin/test_account_reconciliation"
  "$project_root/tests/bin/test_household_check_observation"
  "$project_root/tests/bin/test_issues_admission"
  "$project_root/tests/bin/test_issue_observation"
  "$project_root/tests/bin/test_household_home_observation"
  "$project_root/tests/bin/test_household_home_presentation"
  "$project_root/tests/bin/test_household_home_command"
  "$project_root/tests/bin/test_household_home_interaction"
  "$project_root/tests/bin/test_household_home_tui_input"
}

command="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command" in
  help|-h|--help)
    usage
    ;;
  build)
    ensure_local_index
    exec alr build "$@"
    ;;
  test)
    build_tests
    run_tests "$@"
    ;;
  prove)
    if [[ $# -ne 0 ]]; then
      echo "tools/hra prove: unexpected arguments" >&2
      exit 2
    fi
    exec "$project_root/tools/prove"
    ;;
  qualify)
    if [[ $# -ne 0 ]]; then
      echo "tools/hra qualify: unexpected arguments" >&2
      exit 2
    fi
    build_production
    build_tests
    run_tests
    "$project_root/tools/prove"
    ;;
  clean)
    need_alr
    alr clean "$@"
    rm -rf \
      "$project_root/obj" \
      "$project_root/bin" \
      "$project_root/config" \
      "$project_root/tests/obj" \
      "$project_root/tests/bin" \
      "$project_root/proof/obj"
    ;;
  home|tui|check|report|version)
    build_production
    exec "$project_root/bin/hra" "$command" "$@"
    ;;
  app-help)
    build_production
    exec "$project_root/bin/hra" help "$@"
    ;;
  *)
    echo "tools/hra: unknown command: $command" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
