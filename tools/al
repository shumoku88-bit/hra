#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_root"

usage() {
  cat <<'EOF'
Usage: tools/al COMMAND [ARGS...]

Repository commands:
  build                 Build production source with Alire
  test                  Build and run the repository test suites
  prove                 Run the SPARK proof project
  qualify               Build production, run tests, and prove
  clean                 Clean production, test, and proof build products

Application commands:
  check [--base ROOT]   Validate an admitted canonical Household
  report [--base ROOT]  Render the current report portfolio
  tui [--base ROOT]     Launch the experimental TUI
  version               Show the aledger version
  app-help              Show the aledger application help

This script is the repository command hub. It owns command dispatch only;
domain semantics and writer authority remain in Ada packages.
EOF
}

need_alr() {
  if ! command -v alr >/dev/null 2>&1; then
    echo "tools/al: alr is not available on PATH" >&2
    exit 127
  fi
}

build_production() {
  need_alr
  alr build
}

build_tests() {
  need_alr
  alr exec -- gprbuild -P "$project_root/tests/aledger_tests.gpr"
}

run_tests() {
  "$project_root/tests/bin/test_runner" "$@"
  "$project_root/tests/bin/test_actual_admission"
  "$project_root/tests/bin/test_plan_completion_admission"
}

command="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command" in
  help|-h|--help)
    usage
    ;;
  build)
    need_alr
    exec alr build "$@"
    ;;
  test)
    build_tests
    run_tests "$@"
    ;;
  prove)
    if [[ $# -ne 0 ]]; then
      echo "tools/al prove: unexpected arguments" >&2
      exit 2
    fi
    exec "$project_root/tools/prove"
    ;;
  qualify)
    if [[ $# -ne 0 ]]; then
      echo "tools/al qualify: unexpected arguments" >&2
      exit 2
    fi
    build_production
    build_tests
    run_tests
    "$project_root/tools/prove"
    ;;
  clean)
    need_alr
    alr clean "$@"
    rm -rf "$project_root/tests/obj" "$project_root/tests/bin" "$project_root/proof/obj"
    ;;
  check|report|tui|version)
    build_production
    exec "$project_root/bin/aledger" "$command" "$@"
    ;;
  app-help)
    build_production
    exec "$project_root/bin/aledger" help "$@"
    ;;
  *)
    echo "tools/al: unknown command: $command" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
